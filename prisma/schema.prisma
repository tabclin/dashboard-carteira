generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  plan          Plan           @default(FREE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  professionals Professional[]
  usageLogs     UsageLog[]

  @@map("organizations")
}

model Professional {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  authUserId   String        @unique @map("auth_user_id")
  name         String
  email        String        @unique
  crm          String?
  specialty    String?
  avatarUrl    String?       @map("avatar_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  analyses               Analysis[]
  catalog                ExamCatalog[]
  patients               Patient[]
  examReferenceOverrides ExamReferenceOverride[]
  driAvaliacoes          DriAvaliacao[]
  planoAlimentares       PlanoAlimentar[]
  orientacoes            Orientacao[]
  orientacaoTemplates    OrientacaoTemplate[]
  consultas              Consulta[]
  integracaoGestaoDS     IntegracaoGestaoDS?
  tarefas                Tarefa[]
  preferenciasTarefas    PreferenciasTarefas?
  organization           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("professionals")
}

model Patient {
  id             String       @id @default(cuid())
  professionalId String       @map("professional_id")
  name           String
  birthDate      DateTime?    @map("birth_date") @db.Date
  email          String?
  phone          String?
  sex            String?
  notes          String?
  clinikpiId     String?      @unique @map("clinikpi_id")
  gestaodsId     Int?         @map("gestaods_id")
  cpf            String?
  cidade         String?
  proximoAgendamento DateTime? @map("proximo_agendamento") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  analyses       Analysis[]
  orientacoes    Orientacao[]
  consultas      Consulta[]
  driAvaliacoes  DriAvaliacao[]
  planosAlimentares PlanoAlimentar[]
  tarefas        Tarefa[]
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("patients")
}

model Analysis {
  id             String         @id @default(cuid())
  patientId      String         @map("patient_id")
  professionalId String         @map("professional_id")
  collectedAt    DateTime       @map("collected_at") @db.Date
  labName        String?        @map("lab_name")
  status         AnalysisStatus @default(DRAFT)
  pdfUrl         String?        @map("pdf_url")
  pdfStoragePath String?        @map("pdf_storage_path")
  notes           String?
  showDescription Boolean        @default(true) @map("show_description")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  finalizedAt    DateTime?      @map("finalized_at")
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional   Professional   @relation(fields: [professionalId], references: [id])
  results        Result[]

  @@map("analyses")
}

model Result {
  id               String       @id @default(cuid())
  analysisId       String       @map("analysis_id")
  catalogId        String?      @map("catalog_id")
  examName         String       @map("exam_name")
  examSlug         String       @map("exam_slug")
  extractedName    String?      @map("extracted_name")
  category         String?
  value            String?
  valueNumeric     Decimal?     @map("value_numeric") @db.Decimal(10, 4)
  unit             String?
  refMin           Decimal?     @map("ref_min") @db.Decimal(10, 4)
  refMax           Decimal?     @map("ref_max") @db.Decimal(10, 4)
  refText          String?      @map("ref_text")
  status           ResultStatus @default(NOT_EVALUATED)
  professionalNote String?      @map("professional_note")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  analysis         Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  catalog          ExamCatalog? @relation(fields: [catalogId], references: [id])

  @@map("results")
}

model ExamCatalog {
  id             String       @id @default(cuid())
  slug           String
  professionalId String       @map("professional_id")
  displayName    String       @map("display_name")
  category       String?
  description    String?
  unit           String?
  criticalLow    Decimal?     @map("critical_low")   @db.Decimal(10, 4)
  criticalHigh   Decimal?     @map("critical_high")  @db.Decimal(10, 4)
  refMinMale     Decimal?     @map("ref_min_male")   @db.Decimal(10, 4)
  refMaxMale     Decimal?     @map("ref_max_male")   @db.Decimal(10, 4)
  refMinFemale   Decimal?     @map("ref_min_female") @db.Decimal(10, 4)
  refMaxFemale   Decimal?     @map("ref_max_female") @db.Decimal(10, 4)
  aliases        String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  results        Result[]

  @@unique([slug, professionalId])
  @@map("exam_catalog")
}

model ExamCatalogTemplate {
  id           String         @id @default(cuid())
  slug         String         @unique
  displayName  String         @map("display_name")
  category     String?
  description  String?
  unit         String?
  criticalLow  Decimal?       @map("critical_low")   @db.Decimal(10, 4)
  criticalHigh Decimal?       @map("critical_high")  @db.Decimal(10, 4)
  refMinMale   Decimal?       @map("ref_min_male")   @db.Decimal(10, 4)
  refMaxMale   Decimal?       @map("ref_max_male")   @db.Decimal(10, 4)
  refMinFemale Decimal?       @map("ref_min_female") @db.Decimal(10, 4)
  refMaxFemale Decimal?       @map("ref_max_female") @db.Decimal(10, 4)
  aliases      String[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt      @map("updated_at")
  references   ExamReference[]

  @@map("exam_catalog_template")
}

model ExamReference {
  id                String                  @id @default(cuid())
  catalogTemplateId String                  @map("catalog_template_id")
  catalogTemplate   ExamCatalogTemplate     @relation(fields: [catalogTemplateId], references: [id], onDelete: Cascade)
  unit              String
  sex               String                  @default("U")
  ageMinMonths      Int?                    @map("age_min_months")
  ageMaxMonths      Int?                    @map("age_max_months")
  refMin            Decimal?                @map("ref_min") @db.Decimal(10, 4)
  refMax            Decimal?                @map("ref_max") @db.Decimal(10, 4)
  overrides         ExamReferenceOverride[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt      @map("updated_at")

  @@map("exam_reference")
}

model UnitAlias {
  id        String @id @default(cuid())
  canonical String
  alias     String @unique

  @@map("unit_alias")
}

model ExamReferenceOverride {
  id              String        @id @default(cuid())
  professionalId  String        @map("professional_id")
  professional    Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  examReferenceId String        @map("exam_reference_id")
  examReference   ExamReference @relation(fields: [examReferenceId], references: [id], onDelete: Cascade)
  refMin          Decimal?      @map("ref_min") @db.Decimal(10, 4)
  refMax          Decimal?      @map("ref_max") @db.Decimal(10, 4)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt      @map("updated_at")

  @@unique([professionalId, examReferenceId])
  @@map("exam_reference_override")
}

model UsageLog {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  action       UsageAction
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

enum Plan {
  FREE
  PRO
  CLINIC
}

enum AnalysisStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
}

enum ResultStatus {
  NOT_EVALUATED
  NORMAL
  ATTENTION
  DANGER
}

enum UsageAction {
  PDF_UPLOAD
  AI_EXTRACTION
  AI_INTERPRETATION
  REPORT_GENERATED
  REPORT_SENT
}

model DriAvaliacao {
  id             String       @id @default(cuid())
  professionalId String       @map("professional_id")
  patientId      String?      @map("patient_id")
  patientName    String?      @map("patient_name")
  data           DateTime     @default(now())

  // Dados de entrada
  ageMonths      Int          @map("age_months")
  weightKg       Decimal      @map("weight_kg")      @db.Decimal(6, 2)
  heightCm       Decimal      @map("height_cm")      @db.Decimal(6, 2)
  sexInput       String       @map("sex_input")       // 'M', 'F' ou 'both'
  activityLevel  String       @map("activity_level")
  growthFactorM  Decimal?     @map("growth_factor_m") @db.Decimal(6, 2)
  growthFactorF  Decimal?     @map("growth_factor_f") @db.Decimal(6, 2)
  intakeKcal     Decimal?     @map("intake_kcal")     @db.Decimal(8, 2)

  // Resultados
  eerMasc        Decimal?     @map("eer_masc")         @db.Decimal(8, 2)
  eerFem         Decimal?     @map("eer_fem")          @db.Decimal(8, 2)
  kcalPerKgMasc  Decimal?     @map("kcal_per_kg_masc") @db.Decimal(8, 5)
  kcalPerKgFem   Decimal?     @map("kcal_per_kg_fem")  @db.Decimal(8, 5)
  ageCategory    String       @map("age_category")

  notes          String?
  conduta        String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt      @map("updated_at")

  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient        Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  planos         PlanoAlimentar[]

  @@map("dri_avaliacoes")
}

model PlanoAlimentar {
  id             String        @id @default(cuid())
  professionalId String        @map("professional_id")
  patientId      String?       @map("patient_id")
  avaliacaoId    String?       @map("avaliacao_id")
  patientName    String?       @map("patient_name")
  eerKcal        Decimal       @map("eer_kcal")   @db.Decimal(8, 2)
  ageMonths      Int           @map("age_months")
  ageGroup       String        @map("age_group")
  grupos         Json
  refeicoes      Json
  condutaIa      String?       @map("conduta_ia")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt      @map("updated_at")
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  avaliacao      DriAvaliacao? @relation(fields: [avaliacaoId], references: [id], onDelete: SetNull)
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@map("planos_alimentares")
}

model OrientacaoTemplate {
  id             String       @id @default(cuid())
  professionalId String       @map("professional_id")
  title          String
  secoes         Json         @default("[]")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  orientacoes    Orientacao[]

  @@map("orientacao_templates")
}

model Orientacao {
  id               String              @id @default(cuid())
  professionalId   String              @map("professional_id")
  patientId        String?             @map("patient_id")
  templateId       String?             @map("template_id")
  patientName      String?             @map("patient_name")
  title            String
  secoes           Json                @default("[]")
  orientacaoDate   DateTime?           @map("orientacao_date") @db.Date
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt      @map("updated_at")
  professional   Professional        @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  template       OrientacaoTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("orientacoes")
}

// Consultas realizadas, vindas do Gestão DS ou de planilha (supabase/migrations/0002)
model Consulta {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  professionalId String       @map("professional_id")
  patientId      String?      @map("patient_id")
  pacienteNome   String       @map("paciente_nome")
  data           DateTime     @db.Date
  tipo           String?
  tipoResumido   String       @default("outro") @map("tipo_resumido")
  servico        String?
  gestaodsId     Int?         @map("gestaods_id")
  origem         String
  createdAt      DateTime     @default(now()) @map("created_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient        Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([patientId, data(sort: Desc)], map: "consultas_paciente_data")
  @@index([professionalId, data], map: "consultas_profissional_data")
  @@map("consultas")
}

// Chave do Gestão DS de cada login, criptografada pelo app (lib/gestaods/chave.ts)
model IntegracaoGestaoDS {
  professionalId      String       @id @map("professional_id")
  tokenCifrado        String       @map("token_cifrado")
  tokenFinal          String       @map("token_final")
  medicoId            Int?         @map("medico_id")
  ultimaSincronizacao DateTime?    @map("ultima_sincronizacao")
  ultimoStatus        String?      @map("ultimo_status")
  ultimoErro          String?      @map("ultimo_erro")
  ultimoResumo        Json?        @map("ultimo_resumo")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("integracoes_gestaods")
}

// Tarefas: o quê (exames, dri, orientacao), para quem e até quando (supabase/migrations/0003)
model Tarefa {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  professionalId String       @map("professional_id")
  patientId      String       @map("patient_id")
  tipo           String
  prazo          DateTime     @db.Date
  observacao     String?
  status         String       @default("pendente")
  concluidaEm    DateTime?    @map("concluida_em")
  concluidaComo  String?      @map("concluida_como")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([professionalId, status, prazo], map: "tarefas_profissional_status_prazo")
  @@index([patientId, status], map: "tarefas_paciente")
  @@map("tarefas")
}

// Prazo padrão (dias) de cada tipo de tarefa, por login
model PreferenciasTarefas {
  professionalId String       @id @map("professional_id")
  diasExames     Int          @default(5) @map("dias_exames")
  diasDri        Int          @default(7) @map("dias_dri")
  diasOrientacao Int          @default(3) @map("dias_orientacao")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("preferencias_tarefas")
}
